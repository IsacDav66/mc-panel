# Copia este archivo a .env y ajusta los valores

# Usuario y contraseña para entrar al panel web
PANEL_USER=admin
PANEL_PASS=cambia-esta-clave

# Puerto donde correrá el panel
PORT=8080

# Carpeta donde está instalado bedrock_server (la que contiene server.properties)
BEDROCK_DIR=/home/ubuntu/bedrock-server

# Nombre del proceso PM2 que corre el bedrock_server
PM2_PROCESS_NAME=minecraft-bedrock
